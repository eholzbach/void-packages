# Template file for 'manifold'
pkgname=manifold
version=3.2.1
revision=1
build_style=cmake
configure_args="-DBUILD_SHARED_LIBS=ON -DMANIFOLD_PAR=ON
 -DMANIFOLD_CROSS_SECTION=OFF -DMANIFOLD_CBIND=OFF -DMANIFOLD_JSBIND=OFF
 -DMANIFOLD_PYBIND=OFF -DMANIFOLD_EXPORT=OFF -DMANIFOLD_DEBUG=OFF
 -DMANIFOLD_TEST=ON -DMANIFOLD_STRICT=OFF -DMANIFOLD_DOWNLOADS=OFF
 -DTRACY_ENABLE=OFF"
hostmakedepends="pkg-config"
makedepends="tbb-devel gtest-devel"
short_desc="Geometry library for topological robustness"
maintainer="Orphaned <orphan@voidlinux.org>"
license="Apache-2.0"
homepage="https://github.com/elalish/manifold"
distfiles="https://github.com/elalish/manifold/archive/refs/tags/v${version}.tar.gz"
checksum=c2fddb0f4b2289caff660b29677883f0324415a9901f8f2aed4c83851f994c13

manifold-devel_package() {
	short_desc+=" - development files"
	depends="${sourcepkg}>=${version}_${revision} tbb-devel"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"
	}
}
